{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icink.local/schemas/icink.page.schema.json",
  "title": "icink pages/page_XXXX.json",
  "description": "单页墨迹数据。坐标单位毫米，原点左上角。契约版本 v1。",
  "type": "object",
  "additionalProperties": true,
  "required": ["pageIndex", "sizeMm", "strokes", "shapes", "images", "textBoxes"],
  "properties": {
    "pageIndex": { "type": "integer", "minimum": 1 },
    "sizeMm": { "$ref": "#/$defs/sizeMm" },
    "background": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["blank", "grid", "dotted", "lined", "pdf"] },
        "param": { "type": "object", "additionalProperties": true }
      }
    },
    "strokes": {
      "type": "array",
      "items": { "$ref": "#/$defs/stroke" }
    },
    "shapes": {
      "type": "array",
      "items": { "$ref": "#/$defs/shape" }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "asset", "rectMm"],
        "properties": {
          "id": { "type": "string", "pattern": "^img_\\d{4}$" },
          "asset": { "type": "string", "pattern": "^assets/.+\\.(png|jpg|jpeg|webp)$" },
          "rectMm": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          }
        }
      }
    },
    "textBoxes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "rectMm", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^t_\\d{4}$" },
          "rectMm": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "text": { "type": "string", "maxLength": 2000 },
          "fontSizeMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 }
        }
      }
    }
  },
  "$defs": {
    "sizeMm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 20000 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 20000 }
      }
    },
    "point": {
      "type": "array",
      "description": "[x_mm, y_mm, pressure(0..1), timeMs]",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number", "minimum": -10000, "maximum": 10000 },
        { "type": "number", "minimum": -10000, "maximum": 10000 },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "integer", "minimum": 0 }
      ],
      "items": false
    },
    "stroke": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "tool", "color", "widthMm", "points"],
      "properties": {
        "id": { "type": "string", "pattern": "^s_\\d{4}$" },
        "tool": { "type": "string", "enum": ["pen", "highlighter", "eraser"] },
        "color": { "type": "string", "pattern": "^#[0-9A-F]{6}([0-9A-F]{2})?$" },
        "widthMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/point" }
        },
        "renderedAs": {
          "type": "string",
          "pattern": "^sh_\\d{4}$",
          "description": "若该笔画已被规整为图形，指向 shapes[].id；此时渲染端只画 shapes"
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "shapeType", "params", "decidedBy"],
      "properties": {
        "id": { "type": "string", "pattern": "^sh_\\d{4}$" },
        "shapeType": {
          "type": "string",
          "enum": ["triangle", "rectangle", "circle", "line", "coordinate_system", "function_curve"]
        },
        "params": { "type": "object", "additionalProperties": true },
        "sourceStrokeIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^s_\\d{4}$" }
        },
        "rawPoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        },
        "decidedBy": { "type": "string", "enum": ["local", "model", "user"] },
        "autoLabels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["angle", "right_angle", "equal_edge", "vertex", "intercept"] },
              "at": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              },
              "valueDeg": { "type": "number", "minimum": -360, "maximum": 360 }
            }
          }
        }
      }
    }
  }
}
